{
  "name": "job-hunt-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted job search skills, prompts, guides, and ATS-safe DOCX/PDF export",
  "homepage": "https://github.com/Remotivated/job-hunt-skills#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Remotivated/job-hunt-skills.git"
  },
  "license": "MIT",
  "scripts": {
    "scaffold": "node scripts/scaffold-state.mjs",
    "build:zip": "node scripts/build-cowork-zip.mjs",
    "docx": "python scripts/generate-docx.py",
    "test:docx": "python scripts/test_generate_docx.py",
    "test:skills": "python scripts/test_skill_contracts.py",
    "check:hygiene": "python scripts/check-content-hygiene.py",
    "check:links": "python scripts/check-internal-links.py",
    "build:vendor": "esbuild scripts/vendor-entry.mjs --bundle --format=esm --platform=node --legal-comments=none --minify --outfile=scripts/vendor/export-deps.mjs",
    "export": "node scripts/export-documents.mjs",
    "test:export": "node --test scripts/test-export.mjs"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "esbuild": "^0.28.1",
    "markdown-it": "^14.3.0",
    "pdfmake": "^0.3.11"
  }
}
